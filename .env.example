# Arb Cannon: M&A Leak Arbitrage Command Center — Environment Configuration
# Copy this file to .env and populate credentials to enable live 5:00 PM EST SMTP email delivery.
# Note: Zero brokerage credentials are ever requested or used (100% read-only public data).

# Gmail / SMTP SSL Configuration (Port 465)
SMTP_EMAIL=your_desk_alert_email@gmail.com
SMTP_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
ALERT_RECIPIENT_EMAIL=your_recipient_email@gmail.com

# SEC EDGAR Compliant User-Agent Header (Required by data.sec.gov fair-access policy)
SEC_USER_AGENT="ArbCannonMonitor arb_research@example.com"

# Optional FastAPI Server Bindings
ARB_CANNON_HOST=127.0.0.1
ARB_CANNON_PORT=8000
