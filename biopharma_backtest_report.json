  "gatekeeper_rules": [
    {
      "id": "BIO_GATE_1_FDA_COMMERCIAL_ANCHOR",
      "name": "BIO_GATE_1",
      "title": "FDA-Approved Commercial Anchor (Zero Pending Binary Phase 3 Risk)",
      "description": "Target must have an FDA-approved, commercially marketed flagship asset that has already cleared its pivotal PDUFA/REMS approval hurdle.",
      "hard_fail": "Pre-commercial / clinical-stage target awaiting NDA approval or REMS negotiation (e.g., CYTK aficamten Jan 2024 walk-away; BBIO Mar 2023)."
    },
    {
      "id": "BIO_GATE_2_NAMED_SUITOR_AND_PRICE",
      "name": "BIO_GATE_2",
      "title": "Named Big Pharma Suitor & Explicit Bid / Sweetening Trajectory",
      "description": "Tier-1 scoop must identify a specific cash-rich Big Pharma suitor and an explicit per-share bid or bid-sweetening / CVR bridge trajectory.",
      "hard_fail": "Vague 'weighing options' or 'attracting interest' leak with no named pharma buyer (e.g., APLS Apr 2023, BBIO Mar 2023)."
    },
    {
      "id": "BIO_GATE_3_BOLT_ON_EV_SWEET_SPOT",
      "name": "BIO_GATE_3",
      "title": "$3B\u2013$15B Bolt-On Enterprise Value Sweet Spot (Balance-Sheet Cash)",
      "description": "Implied deal Enterprise Value between $3.0B and $15.0B so the Big Pharma acquirer can fund 100% from balance-sheet cash/commercial paper.",
      "hard_fail": "Mega-deal > $20B requiring syndicated debt and triggering automatic multi-quarter FTC Second Requests (e.g., SGEN $43B)."
    },
    {
      "id": "BIO_GATE_4_ZERO_MOA_ANTITRUST_OVERLAP",
      "name": "BIO_GATE_4",
      "title": "Zero Horizontal Mechanism-of-Action (MoA) FTC Overlap",
      "description": "Acquirer must not market or develop a late-stage drug with the exact same Mechanism of Action (MoA) in the same commercial indication.",
      "hard_fail": "Direct commercial MoA overlap inviting an FTC administrative complaint."
    },
    {
      "id": "BIO_GATE_5_SPREAD_VS_UNAFFECTED_FLOOR",
      "name": "BIO_GATE_5",
      "title": ">= 10.0% Base Pre-8-K Gross Spread + CVR / Sweetening Upside",
      "description": "Post-leak settled entry must offer >= 10.0% gross spread to the base all-cash proposal (plus free call optionality on any sweetened bid / CVR).",
      "hard_fail": "Pre-8-K spread compressed below 8.0% despite multi-day diligence risk."
    },
    {
      "id": "BIO_GATE_6_HALF_CLIP_TRANCHE_LADDER",
      "name": "BIO_GATE_6",
      "title": "50% Bolt-On Clip Cap ($190k) & 10% / 12.5% / 15% Discount Ladder",
      "description": "Cap total allocation at 50% of standard PE clip ($190,000) to account for multi-day negotiation hold time and ~-17% walk-away gap risk. Stage 3 limit tranches at 10.0% (40%), 12.5% (35%), and 15.0% (25%) discount to cash floor.",
      "hard_fail": "Oversizing > $200k or chasing day-1 intraday spikes before T+1 settlement."
    }
  ],
